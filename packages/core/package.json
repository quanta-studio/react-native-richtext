{
  "name": "@yk-yong/react-native-richtext-core",
  "version": "0.1.0",
  "description": "Render-model builder for react-native-richtext: DOM + computed styles -> renderer-agnostic styled tree. React-free.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yk-yong/react-native-richtext.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "html",
    "react-native",
    "rich-text",
    "render-tree"
  ],
  "dependencies": {
    "@yk-yong/react-native-richtext-css": "workspace:*",
    "@yk-yong/react-native-richtext-dom": "workspace:*",
    "entities": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2"
  }
}
