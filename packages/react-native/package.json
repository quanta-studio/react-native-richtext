{
  "name": "@yk-yong/react-native-richtext",
  "version": "0.2.0",
  "description": "Fabric-native HTML renderer for React Native: the <RichText> component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yk-yong/react-native-richtext.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "react-native",
    "html",
    "rich-text",
    "renderer",
    "fabric"
  ],
  "dependencies": {
    "@yk-yong/react-native-richtext-core": "workspace:*",
    "@yk-yong/react-native-richtext-css": "workspace:*",
    "@yk-yong/react-native-richtext-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^19.1.0",
    "react": "18.3.1",
    "react-native": "^0.86.0",
    "react-test-renderer": "18.3.1"
  }
}
