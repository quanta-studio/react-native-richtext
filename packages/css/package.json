{
  "name": "@quanta-studio/react-native-richtext-css",
  "version": "0.2.1",
  "description": "CSS engine for react-native-richtext: cascade, specificity, inheritance, and declaration->RN style resolution. React-free.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanta-studio/react-native-richtext.git",
    "directory": "packages/css"
  },
  "homepage": "https://quanta-studio.github.io/react-native-richtext/",
  "bugs": {
    "url": "https://github.com/quanta-studio/react-native-richtext/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "css",
    "cascade",
    "react-native",
    "rich-text",
    "stylesheet"
  ],
  "dependencies": {
    "@quanta-studio/react-native-richtext-dom": "workspace:*",
    "css-select": "^7.0.0",
    "css-to-react-native": "^3.2.0",
    "css-tree": "^3.2.1"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/node": "^25.9.2"
  }
}
